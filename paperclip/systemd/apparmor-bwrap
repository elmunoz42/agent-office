# AppArmor profile for Ubuntu 24.04+: lets only bubblewrap (the system copy and
# the copy bundled with the Codex CLI) create unprivileged user namespaces,
# which the Codex and Paperclip Runner sandboxes need. The global restriction
# (kernel.apparmor_restrict_unprivileged_userns = 1) stays on for everything else.
# Install (once, as an admin):
#   sudo install -m 644 apparmor-bwrap /etc/apparmor.d/bwrap-userns
#   sudo apparmor_parser -r /etc/apparmor.d/bwrap-userns
abi <abi/4.0>,
include <tunables/global>

profile bwrap-userns /{usr/,}bin/bwrap flags=(unconfined) {
  userns,
  include if exists <local/bwrap-userns>
}

profile codex-bwrap-userns /home/*/.nvm/versions/node/*/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-x64/vendor/*/codex-resources/bwrap flags=(unconfined) {
  userns,
  include if exists <local/codex-bwrap-userns>
}
