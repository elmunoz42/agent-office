# Space Exploration News Paperclip instance (Linux host). Loopback only:
# reach it from a laptop through an SSH tunnel (ssh -L 3100:127.0.0.1:3100).
[Unit]
Description=Paperclip (Space Exploration News)
After=network-online.target

[Service]
WorkingDirectory=%h/dev/agent-office/paperclip
Environment=PAPERCLIP_HOME=%h/.paperclip-sen
Environment=PATH=%h/dev/agent-office/paperclip/node_modules/.bin:%h/.local/bin:%h/.nvm/versions/node/v24.20.0/bin:/usr/local/bin:/usr/bin:/bin
UMask=0022
# Preload the runner platform probe before the server's heavy imports: it
# times out after 1 s, and on a small instance the busy startup event loop
# makes it miss, so Paperclip wrongly reports the Paperclip Runner unavailable.
ExecStart=%h/dev/agent-office/paperclip/node_modules/node/bin/node --import=file://%h/dev/agent-office/paperclip/node_modules/@paperclipai/server/dist/lib/agent-runner-platform.js %h/dev/agent-office/paperclip/node_modules/paperclipai/dist/index.js run --instance default
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
